# --- QUAN TRONG: dinh nghia lai 2 fix langevin de RESET tich luy nang luong
# ve 0 truoc khi vao giai doan production. f_fix_hot/f_fix_cold tich luy nang
# luong tu luc fix duoc dinh nghia (KHONG tu dong reset khi reset_timestep),
# neu khong lam lai buoc nay, dE/dt tinh o cuoi se bi cong don ca 200 ps on
# dinh truoc do, lam sai gia tri G. ---
unfix           fix_hot
unfix           fix_cold
fix             fix_hot  g_hot  langevin $(v_T_avg+v_dT/2) $(v_T_avg+v_dT/2) 0.1 $(33333+v_lseed) tally yes
fix             fix_hot  g_hot  langevin 310 $(v_T_avg+v_dT/2) 0.1 $(33333+v_lseed) tally yes
fix             fix_hot  g_hot  langevin 310 310 0.1 $(33333+v_lseed) tally yes
fix             fix_hot  g_hot  langevin 310 310 0.1 33433 tally yes
fix             fix_cold g_cold langevin $(v_T_avg-v_dT/2) $(v_T_avg-v_dT/2) 0.1 $(44444+v_lseed) tally yes
fix             fix_cold g_cold langevin 290 $(v_T_avg-v_dT/2) 0.1 $(44444+v_lseed) tally yes
fix             fix_cold g_cold langevin 290 290 0.1 $(44444+v_lseed) tally yes
fix             fix_cold g_cold langevin 290 290 0.1 44544 tally yes

# SUA LOI (05/08/2026, xac nhan tren may that): "Cannot reset timestep with
# time-dependent fix ave/chunk defined" - fix ave/chunk (favg) dang chay giu
# trang thai thoi gian ben trong nen chan reset_timestep. Phai unfix truoc,
# dinh nghia lai SAU reset (giong cach lam voi fix_hot/fix_cold o tren) - vua
# fix duoc loi, vua co loi phu: file profile_T_*.dat se duoc ghi lai TU DAU
# cho giai doan production (khong con lan voi 200 ps on dinh truoc do), dung
# y muon ban dau la chi lay trung binh phan production.
unfix           favg

# --- Giai doan lay trung binh (production) ---
reset_timestep  0
fix             favg all ave/chunk $(round(0.1/v_dt)) 100 $(round(10/v_dt)) cchunk temp file profile_T_${T_avg}K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 $(round(10/v_dt)) cchunk temp file profile_T_${T_avg}K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_${T_avg}K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_300K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_300K_P_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_300K_P_0.0keV.dat
dump            dmp_nemd all custom $(round(10/v_dt)) dump.nemd_${T_avg}K_${pka_species}_${E_pka_keV}keV.lammpstrj id type x y z
dump            dmp_nemd all custom 40000 dump.nemd_${T_avg}K_${pka_species}_${E_pka_keV}keV.lammpstrj id type x y z
dump            dmp_nemd all custom 40000 dump.nemd_300K_${pka_species}_${E_pka_keV}keV.lammpstrj id type x y z
dump            dmp_nemd all custom 40000 dump.nemd_300K_P_${E_pka_keV}keV.lammpstrj id type x y z
dump            dmp_nemd all custom 40000 dump.nemd_300K_P_0.0keV.lammpstrj id type x y z
run             $(round(v_t_prod/v_dt))          # ~400 ps production - du dai de trung binh dong nhiet on dinh
run             800000          
