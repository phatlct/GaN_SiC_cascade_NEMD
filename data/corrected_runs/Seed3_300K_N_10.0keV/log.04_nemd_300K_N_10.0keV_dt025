LAMMPS (22 Jul 2025 - Update 6)
# ==============================================================================
# in.04_nemd_thermal.lammps
# Buoc 5: Ap dat gradient nhiet (NEMD hai vung nong/lanh - "two-region"
# method) de do dong nhiet qua giao dien GaN/SiC va tinh do dan nhiet
# giao dien (interfacial / Kapitza thermal conductance, G).
#
# Phuong phap: direct NEMD hai vung Langevin thermostat (Ikeshoji-Hafskjold
# style). Thay the bang fix "thermal/conductivity" (Muller-Plathe swap) neu
# muon dung reverse-NEMD - script cho phuong an do duoi day dung comment
# o cuoi file.
#
# Cong thuc tinh do dan nhiet giao dien (Kapitza conductance):
#   G = q'' / DeltaT_interface
# trong do q'' [W/m^2] la mat do dong nhiet qua tiet dien ngang,
# DeltaT_interface [K] la do nhay nhiet do (temperature jump) tai giao dien,
# xac dinh tu ngoai suy tuyen tinh profile nhiet do ve 2 phia giao dien.
#
#   q'' = (dE/dt) / A
# voi dE/dt la toc do nang luong bom vao vung nong (hoac rut ra vung lanh)
# o trang thai dung (steady state), A la dien tich mat cat ngang (xy).
# ==============================================================================

units           metal
atom_style      atomic
boundary        p p f
atom_modify     map array
newton          on

# CAP NHAT (05/08/2026): tham so hoa de ten file khop chinh xac voi output
# cua in.03 (restart.postanneal_${T_equil}K_${pka_species}_${E_pka_keV}keV.data).
# Truyen tu dong lenh, vd: -var T_equil 300 -var pka_species Ga -var E_pka_keV 5.0
variable        T_equil    index 300
variable        pka_species index Ga
variable        E_pka_keV  index 5.0
variable        dt       index 0.00025      # ps
variable        t_stab   index 100          # ps
variable        t_prod   index 300          # ps
variable        lseed    index 0            # offset seed Langevin
variable        datafile index data.postanneal_${T_equil}K_${pka_species}_${E_pka_keV}keV.data
variable        datafile index data.postanneal_300K_${pka_species}_${E_pka_keV}keV.data
variable        datafile index data.postanneal_300K_N_${E_pka_keV}keV.data
variable        datafile index data.postanneal_300K_N_10.0keV.data
# SUA LOI (05/08/2026, xac nhan tren may that): read_restart bao loi "Did not
# assign all restart atoms correctly" tren hop triclinic nghieng manh voi
# nhieu tien trinh MPI. Doi sang read_data (on dinh hon qua kiem chung that).
read_data       ${datafile}
read_data       data.postanneal_300K_N_10.0keV.data
Reading data file ...
  triclinic box = (0 0 0) to (61.654054 53.393977 116.90099) with tilt (30.827027 0 0)
WARNING: Triclinic box skew is large. LAMMPS will run inefficiently. (src/domain.cpp:221)
  1 by 1 by 4 MPI processor grid
  reading atoms ...
  33660 atoms
  reading velocities ...
  33660 velocities
  read_data CPU = 0.141 seconds

# Force field DA XAC NHAN - xem 02_Force_Field/LJ_interface_crossterms_UFF.md
variable        lj_scale index 1.0     # he so scale LJ giao dien cho sensitivity scan
# CANH BAO GPU (05/08/2026): KHONG dung "-sf gpu" (loi "GPU package styles
# must not be used multiple times" khi 2 substyle TRUNG TEN). Chi dung
# "-pk gpu 1 platform X" - xem QUY_TRINH_CHAY_NGHIEN_CUU.md.
# CAP NHAT (06/08/2026, nang cap hieu nang): substyle GaN chuyen sang
# "tersoff/gpu", substyle SiC giu "tersoff" (CPU) - 2 ten KHAC NHAU nen
# khong bi chan, khong con can chi so 1/2 trong pair_coeff. Da kiem chung
# qua test proxy (tersoff/omp), PotEng khop chinh xac voi ban CPU thuan.
# CAP NHAT (05/08/2026, xac nhan qua test that): BAT BUOC them "neigh no"
# vao lenh -pk gpu, neu khong se loi "Must not use GPU neighbor lists with
# hybrid pair style".
# CAP NHAT (11/08/2026, sau 12 to hop chay on dinh khong crash): BAT LAI OMP
# cho substyle SiC, GIOI HAN tong luong = 14 (giu dung 70%% da chot) bang
# cach GIAM MPI tu 14 xuong 7 VA them 2 luong OMP/tien trinh (7x2=14 luong).
# RUI RO: neu LAMMPS khong bien dich kem OPENMP se bao loi ngay khi khoi
# dong - neu gap, doi ve "tersoff" (bo /omp) va "-n 14" (bo "-pk omp").
pair_style      hybrid/overlay tersoff tersoff lj/cut 10.0
pair_coeff      * * tersoff 1 GaN.tersoff Ga N NULL NULL
Reading tersoff potential file GaN.tersoff with DATE: 2007-10-22
pair_coeff      * * tersoff 2 SiC.tersoff NULL NULL Si C
Reading tersoff potential file SiC.tersoff with DATE: 2011-04-26
pair_coeff      1 1 lj/cut 0.0 1.0 2.0
pair_coeff      2 2 lj/cut 0.0 1.0 2.0
pair_coeff      1 2 lj/cut 0.0 1.0 2.0
pair_coeff      3 3 lj/cut 0.0 1.0 2.0
pair_coeff      4 4 lj/cut 0.0 1.0 2.0
pair_coeff      3 4 lj/cut 0.0 1.0 2.0
pair_coeff      1 3 lj/cut $(0.01771*v_lj_scale) 3.8654   # Ga-Si (UFF combining rule)
pair_coeff      1 3 lj/cut 0.017710000000000000048 3.8654   
pair_coeff      1 4 lj/cut $(0.00905*v_lj_scale) 3.6602   # Ga-C
pair_coeff      1 4 lj/cut 0.0090500000000000007522 3.6602   
pair_coeff      2 3 lj/cut $(0.00722*v_lj_scale) 3.5322   # N-Si
pair_coeff      2 3 lj/cut 0.0072199999999999998554 3.5322   
pair_coeff      2 4 lj/cut $(0.00369*v_lj_scale) 3.3447   # N-C
pair_coeff      2 4 lj/cut 0.0036900000000000001375 3.3447   

variable        T_avg equal ${T_equil}    # nhiet do trung binh he (= T_equil o tren)
variable        T_avg equal 300    
variable        dT    index 20.0         # bien do chenh lech nong/lanh (nho de giu tuyen tinh)

# --- Xac dinh cac vung doc truc z: nong (trong SiC, xa giao dien), lanh (trong GaN, xa giao dien) ---
variable        zlo equal bound(all,zmin)
variable        zhi equal bound(all,zmax)
variable        Lz  equal (v_zhi-v_zlo)

region          r_hot  block INF INF INF INF $(v_zlo+5.0) $(v_zlo+25.0) units box
region          r_hot  block INF INF INF INF 5.1627503714682516645 $(v_zlo+25.0) units box
region          r_hot  block INF INF INF INF 5.1627503714682516645 25.162750371468252553 units box
region          r_cold block INF INF INF INF $(v_zhi-25.0) $(v_zhi-5.0) units box
region          r_cold block INF INF INF INF 89.927998942274001593 $(v_zhi-5.0) units box
region          r_cold block INF INF INF INF 89.927998942274001593 109.92799894227400159 units box
region          r_fixed_lo block INF INF INF INF ${zlo} $(v_zlo+3.0) units box
region          r_fixed_lo block INF INF INF INF 0.162750371468252 $(v_zlo+3.0) units box
region          r_fixed_lo block INF INF INF INF 0.162750371468252 3.1627503714682521085 units box
region          r_fixed_hi block INF INF INF INF $(v_zhi-3.0) ${zhi} units box
region          r_fixed_hi block INF INF INF INF 111.92799894227400159 ${zhi} units box
region          r_fixed_hi block INF INF INF INF 111.92799894227400159 114.927998942274 units box

group           g_hot  region r_hot
6339 atoms in group g_hot
group           g_cold region r_cold
5776 atoms in group g_cold
group           g_fixed region r_fixed_lo
1200 atoms in group g_fixed
group           g_fixed_hi region r_fixed_hi
1083 atoms in group g_fixed_hi
group           g_fixed union g_fixed g_fixed_hi
2283 atoms in group g_fixed
group           g_mobile subtract all g_fixed
31377 atoms in group g_mobile

# --- Chunk theo z de tinh profile nhiet do (dung cho phan tich sau) ---
# SUA LOI (05/08/2026, xac nhan tren may that): "compute chunk/atom for
# triclinic boxes requires units reduced" - hop mo phong la triclinic (tilt
# xy=30.827 do cau truc GaN/SiC), LAMMPS BAT BUOC dung "units reduced" cho
# compute chunk/atom tren hop triclinic (khong duoc dung "units box" nhu ban
# goc). Vi tilt chi o mat phang xy (xz=yz=0), truc z KHONG bi xien nen chuyen
# doi reduced<->that chi la 1 phep nhan vo huong voi Lz (khong lien quan x,y).
# Be rong bin quy doi tu 2.0 Angstrom sang phan so (2.0/Lz) de GIU NGUYEN
# be rong vat ly ~2 Angstrom nhu thiet ke ban dau.
# QUAN TRONG: cot "Coord1" trong file profile_T_*.dat sau khi doi se la
# PHAN SO (0-1) cua Lz, KHONG con la Angstrom nua - da cap nhat
# post_process_thermal_conductance.py (them tham so --lz) de tu dong quy doi
# lai ve Angstrom truoc khi phan tich, xem huong dan in ra cuoi file nay.
compute         cchunk all chunk/atom bin/1d z lower $(2.0/v_Lz) units reduced
compute         cchunk all chunk/atom bin/1d z lower 0.01742687812649203194 units reduced
fix             favg all ave/chunk $(round(0.1/v_dt)) 100 $(round(10/v_dt)) cchunk temp file profile_T_${T_avg}K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 $(round(10/v_dt)) cchunk temp file profile_T_${T_avg}K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_${T_avg}K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_300K_${pka_species}_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_300K_N_${E_pka_keV}keV.dat
fix             favg all ave/chunk 400 100 40000 cchunk temp file profile_T_300K_N_10.0keV.dat

# --- Thermostat hai vung (Langevin) tao gradient nhiet ---
# SUA LOI (05/08/2026, xac nhan tren may that): "Fix fix_hot langevin does
# not support fix_modify energy command" - ban LAMMPS nay KHONG cho fix
# langevin dung fix_modify energy de tich luy nang luong (khac voi fix nhu
# indent/wall). Cach dung cua fix langevin la keyword "tally yes" ngay trong
# dong lenh fix - da doi lai, f_fix_hot/f_fix_cold van tra ve nang luong tich
# luy (eV) dung nhu thiet ke ban dau, chi khac cu phap bat tinh nang.
fix             fix_hot  g_hot  langevin $(v_T_avg+v_dT/2) $(v_T_avg+v_dT/2) 0.1 $(11111+v_lseed) tally yes
fix             fix_hot  g_hot  langevin 310 $(v_T_avg+v_dT/2) 0.1 $(11111+v_lseed) tally yes
fix             fix_hot  g_hot  langevin 310 310 0.1 $(11111+v_lseed) tally yes
fix             fix_hot  g_hot  langevin 310 310 0.1 11111 tally yes
fix             fix_cold g_cold langevin $(v_T_avg-v_dT/2) $(v_T_avg-v_dT/2) 0.1 $(22222+v_lseed) tally yes
fix             fix_cold g_cold langevin 290 $(v_T_avg-v_dT/2) 0.1 $(22222+v_lseed) tally yes
fix             fix_cold g_cold langevin 290 290 0.1 $(22222+v_lseed) tally yes
fix             fix_cold g_cold langevin 290 290 0.1 22222 tally yes
fix             fix_nve  g_mobile nve
fix             fix_freeze g_fixed setforce 0.0 0.0 0.0

# SUA LOI (07/08/2026, phong ngua chu dong sau khi in.02 gap "Lost atoms" o
# E_pka_keV=7.0): them tuong phan xa cung (elastic) tai chinh bien hop theo
# truc z, CHI kich hoat trong truong hop hiem nguyen tu sap thoat ra ngoai -
# khong anh huong vat ly binh thuong. Xem giai thich day du trong in.02.
fix             fix_wall_z all wall/reflect zlo EDGE zhi EDGE

# --- Theo doi nang luong tich luy do thermostat bom vao / rut ra (de tinh q) ---
compute         etally_hot  g_hot  temp
compute         etally_cold g_cold temp

thermo          $(round(0.5/v_dt))
thermo          2000
thermo_style    custom step temp c_etally_hot c_etally_cold f_fix_hot f_fix_cold
thermo_modify   flush yes

timestep        ${dt}
timestep        0.00025

# --- Giai doan on dinh trang thai dung (steady state) ---
run             $(round(v_t_stab/v_dt))          # ~200 ps - kiem tra profile nhiet do tuyen tinh moi ben giao dien
run             200000          
