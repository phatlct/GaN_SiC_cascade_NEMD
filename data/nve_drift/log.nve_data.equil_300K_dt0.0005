LAMMPS (22 Jul 2025 - Update 6)
# ==============================================================================
# in.04_nemd_thermal.lammps
# Buoc 5: Ap dat gradient nhiet (NEMD hai vung nong/lanh - "two-region"
# method) de do dong nhiet qua giao dien GaN/SiC va tinh do dan nhiet
# giao dien (interfacial / Kapitza thermal conductance, G).
#
# Phuong phap: direct NEMD hai vung Langevin thermostat (Ikeshoji-Hafskjold
# style). Thay the bang fix "thermal/conductivity" (Muller-Plathe swap) neu
# muon dung reverse-NEMD - script cho phuong an do duoi day dung comment
# o cuoi file.
#
# Cong thuc tinh do dan nhiet giao dien (Kapitza conductance):
#   G = q'' / DeltaT_interface
# trong do q'' [W/m^2] la mat do dong nhiet qua tiet dien ngang,
# DeltaT_interface [K] la do nhay nhiet do (temperature jump) tai giao dien,
# xac dinh tu ngoai suy tuyen tinh profile nhiet do ve 2 phia giao dien.
#
#   q'' = (dE/dt) / A
# voi dE/dt la toc do nang luong bom vao vung nong (hoac rut ra vung lanh)
# o trang thai dung (steady state), A la dien tich mat cat ngang (xy).
# ==============================================================================

units           metal
atom_style      atomic
boundary        p p f
atom_modify     map array
newton          on

# CAP NHAT (05/08/2026): tham so hoa de ten file khop chinh xac voi output
# cua in.03 (restart.postanneal_${T_equil}K_${pka_species}_${E_pka_keV}keV.data).
# Truyen tu dong lenh, vd: -var T_equil 300 -var pka_species Ga -var E_pka_keV 5.0
variable        T_equil    index 300
variable        pka_species index Ga
variable        E_pka_keV  index 5.0
# SUA LOI (05/08/2026, xac nhan tren may that): read_restart bao loi "Did not
# assign all restart atoms correctly" tren hop triclinic nghieng manh voi
# nhieu tien trinh MPI. Doi sang read_data (on dinh hon qua kiem chung that).
read_data ${datafile}
read_data data.equil_300K.data
Reading data file ...
  triclinic box = (0 0 0) to (61.654054 53.393977 116.90099) with tilt (30.827027 0 0)
WARNING: Triclinic box skew is large. LAMMPS will run inefficiently. (src/domain.cpp:221)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  33660 atoms
  reading velocities ...
  33660 velocities
  read_data CPU = 0.235 seconds

# Force field DA XAC NHAN - xem 02_Force_Field/LJ_interface_crossterms_UFF.md
variable        lj_scale index 1.0     # he so scale LJ giao dien cho sensitivity scan
# CANH BAO GPU (05/08/2026): KHONG dung "-sf gpu" (loi "GPU package styles
# must not be used multiple times" khi 2 substyle TRUNG TEN). Chi dung
# "-pk gpu 1 platform X" - xem QUY_TRINH_CHAY_NGHIEN_CUU.md.
# CAP NHAT (06/08/2026, nang cap hieu nang): substyle GaN chuyen sang
# "tersoff/gpu", substyle SiC giu "tersoff" (CPU) - 2 ten KHAC NHAU nen
# khong bi chan, khong con can chi so 1/2 trong pair_coeff. Da kiem chung
# qua test proxy (tersoff/omp), PotEng khop chinh xac voi ban CPU thuan.
# CAP NHAT (05/08/2026, xac nhan qua test that): BAT BUOC them "neigh no"
# vao lenh -pk gpu, neu khong se loi "Must not use GPU neighbor lists with
# hybrid pair style".
# CAP NHAT (11/08/2026, sau 12 to hop chay on dinh khong crash): BAT LAI OMP
# cho substyle SiC, GIOI HAN tong luong = 14 (giu dung 70%% da chot) bang
# cach GIAM MPI tu 14 xuong 7 VA them 2 luong OMP/tien trinh (7x2=14 luong).
# RUI RO: neu LAMMPS khong bien dich kem OPENMP se bao loi ngay khi khoi
# dong - neu gap, doi ve "tersoff" (bo /omp) va "-n 14" (bo "-pk omp").
pair_style      hybrid/overlay tersoff tersoff lj/cut 10.0
pair_coeff      * * tersoff 1 GaN.tersoff Ga N NULL NULL
Reading tersoff potential file GaN.tersoff with DATE: 2007-10-22
pair_coeff      * * tersoff 2 SiC.tersoff NULL NULL Si C
Reading tersoff potential file SiC.tersoff with DATE: 2011-04-26
pair_coeff      1 1 lj/cut 0.0 1.0 2.0
pair_coeff      2 2 lj/cut 0.0 1.0 2.0
pair_coeff      1 2 lj/cut 0.0 1.0 2.0
pair_coeff      3 3 lj/cut 0.0 1.0 2.0
pair_coeff      4 4 lj/cut 0.0 1.0 2.0
pair_coeff      3 4 lj/cut 0.0 1.0 2.0
pair_coeff      1 3 lj/cut $(0.01771*v_lj_scale) 3.8654   # Ga-Si (UFF combining rule)
pair_coeff      1 3 lj/cut 0.017710000000000000048 3.8654   
pair_coeff      1 4 lj/cut $(0.00905*v_lj_scale) 3.6602   # Ga-C
pair_coeff      1 4 lj/cut 0.0090500000000000007522 3.6602   
pair_coeff      2 3 lj/cut $(0.00722*v_lj_scale) 3.5322   # N-Si
pair_coeff      2 3 lj/cut 0.0072199999999999998554 3.5322   
pair_coeff      2 4 lj/cut $(0.00369*v_lj_scale) 3.3447   # N-C
pair_coeff      2 4 lj/cut 0.0036900000000000001375 3.3447   
variable        zlo equal bound(all,zmin)
variable        zhi equal bound(all,zmax)
region          r_fixed_lo block INF INF INF INF ${zlo} $(v_zlo+3.0) units box
region          r_fixed_lo block INF INF INF INF 0.16342254706363 $(v_zlo+3.0) units box
region          r_fixed_lo block INF INF INF INF 0.16342254706363 3.1634225470636301303 units box
region          r_fixed_hi block INF INF INF INF $(v_zhi-3.0) ${zhi} units box
region          r_fixed_hi block INF INF INF INF 111.77296246412500125 ${zhi} units box
region          r_fixed_hi block INF INF INF INF 111.77296246412500125 114.772962464125 units box
group           g_fixed region r_fixed_lo
1199 atoms in group g_fixed
group           g_fixed_hi region r_fixed_hi
722 atoms in group g_fixed_hi
group           g_fixed union g_fixed g_fixed_hi
1921 atoms in group g_fixed
group           g_mobile subtract all g_fixed
31739 atoms in group g_mobile
fix             fix_nve    g_mobile nve
fix             fix_freeze g_fixed setforce 0.0 0.0 0.0
fix             fix_wall_z all wall/reflect zlo EDGE zhi EDGE
timestep        ${dt}
timestep        0.0005
thermo          100
thermo_style    custom step time temp pe ke etotal
thermo_modify   flush yes
run             ${nsteps}
run             4000
