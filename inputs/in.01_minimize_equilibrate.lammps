# ==============================================================================
# in.01_minimize_equilibrate.lammps
# Step 2 of the workflow: minimization -> NVT equilibration at the target temperature
# System: GaN(wurtzite)/SiC(3C) interface, prior to the PKA event
# Topic: effect of radiation damage on GaN/SiC interfacial heat transport (LiDAR)
# ==============================================================================
#
# Force field (see 02_Force_Field/LJ_interface_crossterms_UFF.md):
#   - GaN.tersoff: Nord-Albe-Erhart 2003, J. Phys.: Condens. Matter 15, 5649
#     (official file distributed with LAMMPS)
#   - SiC.tersoff: Tersoff 1989, Phys. Rev. B 39, 5566 (official LAMMPS file)
#   - Interfacial cross terms Ga-Si/Ga-C/N-Si/N-C: LJ "interfacial glue layer"
#     with parameters from UFF mixing rules (Rappe et al. 1992). This is an
#     approximation acceptable as a first step (similar to published GaN/diamond
#     studies); it should be recalibrated (DFT or a +/-30-50% sensitivity scan)
#     before use in final results.
# ==============================================================================

# --- 1. Initialization ---
units           metal
atom_style      atomic
boundary        p p f          # p p f: non-periodic in z to avoid spurious interactions across the z boundary in later NEMD runs
atom_modify     map array

# --- 2. Read structure ---
read_data       GaN_SiC_interface.data

# --- 2b. Atomic masses (required: the ASE-generated .data file has no Masses
# section, and LAMMPS stops with "Not all per-type masses are set") ---
# Type order follows specorder in build_GaN_SiC_interface.py: Ga N Si C
mass            1 69.723     # Ga
mass            2 14.007     # N
mass            3 28.0855    # Si
mass            4 12.011     # C

# --- 3. Atom groups ---
group           gan   type 1 2      # Ga N
group           sic   type 3 4      # Si C

# --- 3b. Frozen boundary layers at the free surfaces ---
# When NVT is applied to the whole system including atoms at the free z
# surfaces, a small number of weakly bonded edge atoms (~0.03% of the total)
# can be ejected from the non-periodic ("f") box within a few hundred steps,
# causing "Lost atoms". Buffering with dt/reset, tightening the box, or adding
# Langevin damping at the boundary does not resolve this. Instead, a thin layer
# (3 Angstrom, ~1 atomic layer) at both ends of z is frozen with setforce 0
# (not integrated), mimicking bulk material continuing beyond the box. This is
# standard practice for surface/thin-film MD and consistent with the boundary
# treatment (g_boundary) in in.02/in.03/in.04.
variable        zlo_s equal bound(all,zmin)
variable        zhi_s equal bound(all,zmax)
region          r_frz_lo block INF INF INF INF ${zlo_s} $(v_zlo_s+3.0) units box
region          r_frz_hi block INF INF INF INF $(v_zhi_s-3.0) ${zhi_s} units box
group           g_frozen region r_frz_lo
group           g_frozen_hi region r_frz_hi
group           g_frozen union g_frozen g_frozen_hi
group           g_mobile subtract all g_frozen
print           "Number of frozen boundary atoms (3 Angstrom at each end): $(count(g_frozen))"

# Elastic reflecting walls at the z box edges as a safeguard against atoms
# leaving the box (e.g. at high E_pka_keV in in.02). They act only in the rare
# case an atom reaches the edge and do not affect normal dynamics. See in.02.
fix             fix_wall_z all wall/reflect zlo EDGE zhi EDGE

# --- 4. Force field (see 02_Force_Field/LJ_interface_crossterms_UFF.md) ---
variable        lj_scale index 1.0     # interfacial LJ scale factor for the sensitivity scan
                                        # (e.g. lmp -var lj_scale 0.5 -in in.01...)
# GPU notes:
# - The GPU package does not allow the same /gpu pair style to appear twice in
#   hybrid/overlay ("GPU package styles must not be used multiple times"), so
#   "-sf gpu" (which would suffix both tersoff substyles) must not be used with
#   the in.0X files.
# - The restriction applies only to identically named substyles. Here the GaN
#   substyle (21660 atoms, vs. 12000 for SiC) uses tersoff/gpu and the SiC
#   substyle runs on the CPU, which maximizes the load moved off the CPU.
#   Splitting the substyles this way gives the same PotEng (-167244 eV) as a
#   pure CPU run. Since the two substyle names differ, pair_coeff needs no 1/2
#   index to distinguish them.
# - "neigh no" must be passed to -pk gpu; otherwise LAMMPS reports "Must not use
#   GPU neighbor lists with hybrid pair style".
# - The SiC substyle uses tersoff/omp with 7 MPI ranks x 2 OpenMP threads (14
#   threads total, ~70% of available CPU). This requires LAMMPS built with the
#   OPENMP package; otherwise startup fails with "Unknown pair style tersoff/omp"
#   or "Unknown package omp". In that case use plain "tersoff" and "-n 14"
#   (without "-pk omp") in the .bat file.
pair_style      hybrid/overlay tersoff/gpu tersoff/omp lj/cut/gpu 10.0
pair_coeff      * * tersoff/gpu GaN.tersoff Ga N NULL NULL
pair_coeff      * * tersoff/omp SiC.tersoff NULL NULL Si C
# Disable LJ for pairs handled by Tersoff (avoid double counting); a small cutoff
# (2.0 Angstrom) reduces unnecessary neighbor-list cost
pair_coeff      1 1 lj/cut/gpu 0.0 1.0 2.0     # Ga-Ga
pair_coeff      2 2 lj/cut/gpu 0.0 1.0 2.0     # N-N
pair_coeff      1 2 lj/cut/gpu 0.0 1.0 2.0     # Ga-N
pair_coeff      3 3 lj/cut/gpu 0.0 1.0 2.0     # Si-Si
pair_coeff      4 4 lj/cut/gpu 0.0 1.0 2.0     # C-C
pair_coeff      3 4 lj/cut/gpu 0.0 1.0 2.0     # Si-C
# Interfacial LJ glue layer - parameters from UFF combining rules (epsilon[eV] sigma[Angstrom])
pair_coeff      1 3 lj/cut/gpu $(0.01771*v_lj_scale) 3.8654   # Ga-Si
pair_coeff      1 4 lj/cut/gpu $(0.00905*v_lj_scale) 3.6602   # Ga-C
pair_coeff      2 3 lj/cut/gpu $(0.00722*v_lj_scale) 3.5322   # N-Si
pair_coeff      2 4 lj/cut/gpu $(0.00369*v_lj_scale) 3.3447   # N-C

# --- 5. Computes / monitoring ---
compute         pe_atom all pe/atom
compute         ke_atom all ke/atom
compute         stress_atom all stress/atom NULL

thermo          100
thermo_style    custom step temp pe ke etotal press vol fmax fnorm
thermo_modify   flush yes

# --- 6. Minimization (remove initial overlaps / high-energy contacts) ---
# The unrelaxed ASE structure can retain large residual forces (~3-4 eV/Angstrom)
# if minimization is cut short; "velocity create" on such a structure leads to
# "Lost atoms".
#
# FIRE alone converges well for this system (Fmax = 0.213 eV/Angstrom after
# ~230 iterations, stopping on the energy tolerance). A subsequent CG stage can
# make Fmax worse (up to ~2.5 eV/Angstrom) because CG stops early on the energy
# criterion while forces grow, so no CG stage is used.
#
# Tighter tolerances (e.g. 1e-8/1e-10) are counterproductive: FIRE no longer
# stops at the early minimum and enters its oscillatory regime near the minimum,
# with non-monotonic Fmax (up to ~2 eV/Angstrom). The looser tolerances below
# (1e-6/1e-8, limits 2000/20000) let FIRE stop cleanly at a good minimum. Do
# not tighten them or raise the iteration limits for this 33660-atom pilot
# system; re-check separately for larger production systems.
min_style       fire
min_modify      dmax 0.02
minimize        1.0e-6 1.0e-8 2000 20000

variable        fmax_after_min equal fmax
print           "=== MINIMIZATION CONVERGENCE CHECK: Fmax = ${fmax_after_min} eV/Angstrom ==="
if "${fmax_after_min} > 1.0" then &
    "print '*** ERROR: Fmax > 1.0 eV/A after minimization - structure not sufficiently converged. ***'" &
    "print '*** Stopping: check the input structure (overlaps, wrong lattice, incorrect build) before equilibration. Do not simply loosen tolerances or raise iteration limits: FIRE can oscillate and worsen past a good minimum (see notes above). Continuing with large Fmax will cause Lost atoms. ***'" &
    "quit 1"

write_dump      all custom dump.after_min.lammpstrj id type x y z c_pe_atom

# --- 7. NVT equilibration at the target temperature ---
# Run sequentially for the three LiDAR sensor operating temperatures: 300, 350, 400 K,
# using an index variable + jump loop within a single input file.
variable        T_target index 300 350 400

label           loop_temp

reset_timestep  0
timestep        0.001           # ps (metal units)

velocity        g_mobile create ${T_target} 12345 mom yes rot yes dist gaussian

fix             fix_nvt g_mobile nvt temp ${T_target} ${T_target} 0.1
fix             fix_freeze_boundary g_frozen setforce 0.0 0.0 0.0

# "velocity create" imposes an abrupt kinetic-energy kick (Maxwell-Boltzmann,
# independent of the prior state); integrating immediately with a fixed
# 0.001 ps timestep on top of residual forces is unsafe. dt/reset is used as a
# buffer for the first few ps (same technique as the cascade stage in in.02),
# as a second safeguard even when minimization has converged well.
#
# Note: this fix applies only to g_mobile (excluding the frozen boundary
# layers). The main cause of Lost atoms is ejection of boundary atoms (handled
# above), not the timestep change itself; dt/reset is kept as an extra safeguard.
fix             fix_adapt_dt_buffer g_mobile dt/reset 1 1.0e-6 0.001 0.01 units box
run             5000
unfix           fix_adapt_dt_buffer
timestep        0.001

dump            dmp all custom 1000 dump.equil_${T_target}K.lammpstrj id type x y z vx vy vz
dump_modify     dmp sort id

run             95000           # total ~100 ps equilibration (5000 buffer + 95000 main)

unfix           fix_nvt
unfix           fix_freeze_boundary
undump          dmp

write_restart   restart.equil_${T_target}K.data
write_data      data.equil_${T_target}K.data

print           "=== Equilibration finished at ${T_target} K ==="
print           "Check: mean temperature over the last 20 ps should be stable within +/- 5%% of the target"

next            T_target
jump            in.01_minimize_equilibrate.lammps loop_temp

print           "Equilibration finished for all three temperatures 300/350/400 K"
print           "Next step: in.02_pka_cascade.lammps (reads the corresponding restart.equil_<T>K.data)"
